{
  // Openroom: one Cloudflare Worker, one D1 database, one private R2 bucket.
  // The "Deploy to Cloudflare" button (README) creates the database and bucket for you and
  // fills in their ids. Deploying by hand works the same way: `npm run deploy` lets Wrangler
  // create them on the first run.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openroom",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The room is served on your free https://openroom.<your-subdomain>.workers.dev address.
  // For your own domain (for example dataroom.example.com), add it in the Cloudflare dashboard
  // under Workers > openroom > Settings > Domains, or add here:
  //   "routes": [{ "pattern": "dataroom.example.com", "custom_domain": true }]
  // then set APP_ORIGIN to https://dataroom.example.com.
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [{ "binding": "DB", "database_name": "openroom", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "openroom-files" }],
  // No settings here on purpose: the Deploy to Cloudflare form only asks for what it must
  // (ADMIN_EMAILS and RESEND_API_KEY, from .dev.vars.example). Everything else has a sensible
  // default in the code, and branding is set in the app on the Branding tab.
  //
  // Optional settings, added later in the Cloudflare dashboard (Workers & Pages > openroom >
  // Settings > Variables and Secrets), all listed in the README under "All settings":
  //   MAIL_FROM   sender of sign-in emails, once your domain is verified in Resend
  //   APP_ORIGIN  only when you add a custom domain, e.g. https://dataroom.example.com
  //   BRAND_*, SHOW_CREDIT, SES_REGION, MAIL_PROVIDER
  //
  // keep_vars: settings added in the dashboard survive every later deploy.
  "keep_vars": true,
  // Secrets (set with `npx wrangler secret put NAME` or in the dashboard):
  //   ADMIN_EMAILS, RESEND_API_KEY, or AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY for SES.
  "observability": { "enabled": true }
}
