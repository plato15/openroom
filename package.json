{
  "name": "openroom",
  "version": "0.5.0",
  "scripts": {
    "test": "vitest run && vitest run --config vitest.node.config.ts",
    "test:workers": "vitest run",
    "test:node": "vitest run --config vitest.node.config.ts",
    "dev": "wrangler dev --port 8799 --infer-origin-from-routes=false --var ENVIRONMENT:local --var APP_ORIGIN:http://localhost:8799",
    "deploy": "wrangler deploy && wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc -p .",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "build:node": "node scripts/build-node.mjs",
    "start:node": "node dist/server.mjs"
  },
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "aws4fetch": "^1.0.20",
    "fflate": "^0.8.2",
    "hono": "^4.13.18",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.5.0",
    "pdf-lib": "^1.17.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.1",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.161.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "description": "An open-source investor data room: email sign-in links, folder-by-folder access, stamped documents, view tracking. One click on Cloudflare, or Docker on your own server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plato15/openroom.git"
  },
  "keywords": [
    "data-room",
    "dataroom",
    "due-diligence",
    "investors",
    "cloudflare-workers",
    "d1",
    "r2",
    "docker",
    "self-hosted"
  ]
}
