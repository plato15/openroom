# Nothing is needed to deploy: open the room once it is live and the setup screen asks for
# your email and a Resend key. Everything below is optional.
#
# For local dev, copy this file to .dev.vars. Leave ADMIN_EMAILS out to try the setup screen
# (the code is shown on the page locally), or set it to sign straight in as admin.
# ADMIN_EMAILS=you@example.com
