# Settings for docker compose. Copy to .env and fill in.

# Your room's address, without https:// (point its DNS at this server first).
DOMAIN=dataroom.example.com

# Who can manage the room: one email, or several separated by commas.
ADMIN_EMAILS=you@example.com

# Who sign-in emails come from. Must be allowed by your email provider.
MAIL_FROM=Data Room <rooms@example.com>

# Email: fill in ONE of these.
# Resend (resend.com): an API key.
RESEND_API_KEY=
# Or any SMTP server: smtp://user:password@host:587 (or smtps://...:465).
SMTP_URL=
# Or Amazon SES: keys and region.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_REGION=us-east-1

# Files are kept in the openroom-data volume. To keep them in an S3-compatible bucket instead
# (AWS S3, Cloudflare R2, Backblaze B2, MinIO...), fill in all of these:
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=openroom-files
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Default branding. Admins can change it on the Branding tab.
# BRAND_NAME=Acme
