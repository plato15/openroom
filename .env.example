# Settings for docker compose. Copy to .env, set DOMAIN, then `docker compose up -d`.
# Open https://<DOMAIN> and the setup screen asks for your email and a Resend key.

# Your room's address, without https:// (point its DNS at this server first).
DOMAIN=dataroom.example.com

# Everything below is optional. Anything set here wins over the setup screen.

# Who can manage the room, if you would rather not use the setup screen (comma separated).
# ADMIN_EMAILS=you@example.com

# Email set here instead of on the setup screen. Fill in ONE way.
# MAIL_FROM=Data Room <rooms@example.com>
# RESEND_API_KEY=
# Any SMTP server: smtp://user:password@host:587 (or smtps://...:465).
# SMTP_URL=
# Amazon SES:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_REGION=us-east-1

# Files are kept in the openroom-data volume. To keep them in an S3-compatible bucket instead
# (AWS S3, Cloudflare R2, Backblaze B2, MinIO...), fill in all of these:
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=openroom-files
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Default branding. Admins change it on the setup screen and the Settings tab.
# BRAND_NAME=Acme
